{
  "name": "@younggglcy/create-npm-lib",
  "type": "module",
  "version": "0.2.0",
  "description": "younggglcy's custom CLI tool for creating a npm library with a starter template",
  "author": {
    "name": "younggglcy",
    "email": "younggglcy@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/younggglcy/create-npm-lib"
  },
  "keywords": [
    "CLI",
    "npm library template"
  ],
  "bin": {
    "cnl": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "rolldown -c rolldown.config.ts -w",
    "build": "rolldown -c rolldown.config.ts",
    "lint": "eslint .",
    "lint:fix": "bun run lint --fix",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "release": "bun scripts/release.ts",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "node-lts-versions": "^1.7.3",
    "rollup-plugin-copy": "^3.5.0",
    "tinyexec": "^1.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@changesets/cli": "^2.29.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.7.1",
    "eslint": "^9.37.0",
    "lint-staged": "^16.2.3",
    "rolldown": "1.0.0-beta.42",
    "rolldown-plugin-dts": "^0.16.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*": "bun run lint:fix --cache"
  }
}
