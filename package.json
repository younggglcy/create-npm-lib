{
  "name": "@younggglcy/create-npm-lib",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@10.18.2",
  "description": "younggglcy's custom CLI tool for creating a npm library with a starter template",
  "author": {
    "name": "younggglcy",
    "email": "younggglcy@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/younggglcy/create-npm-lib"
  },
  "keywords": [],
  "bin": {
    "cnl": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "rolldown -c rolldown.config.ts -w",
    "build": "rolldown -c rolldown.config.ts",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "release": "bumpp"
  },
  "dependencies": {
    "@inquirer/prompts": "catalog:prod",
    "chalk": "catalog:prod",
    "commander": "catalog:prod",
    "fs-extra": "catalog:prod",
    "husky": "catalog:tool",
    "node-lts-versions": "catalog:prod",
    "rollup-plugin-copy": "catalog:bundler",
    "semantic-release": "catalog:tool",
    "tinyexec": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:tool",
    "@types/fs-extra": "catalog:types",
    "@types/node": "catalog:types",
    "bumpp": "catalog:tool",
    "eslint": "catalog:tool",
    "lint-staged": "catalog:tool",
    "rolldown": "catalog:bundler",
    "rolldown-plugin-dts": "catalog:bundler",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "lint-staged": {
    "*": "pnpm lint:fix --cache"
  }
}
